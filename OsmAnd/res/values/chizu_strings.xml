	<!-- 渋滞回避: traffic-aware routing -->
	<string name="chizu_section_traffic">Traffic (渋滞回避)</string>
	<string name="chizu_traffic_enabled">Avoid traffic</string>
	<string name="chizu_traffic_enabled_descr">Reads Google traffic colours along the route (https, anonymous browser identity) and routes around red jams. Car profile only.</string>
	<string name="chizu_traffic_chooser">Route choice at planning</string>
	<string name="chizu_traffic_chooser_descr">Offer up to five routes side by side: traffic-aware variants, shortest, and the plain route.</string>
	<string name="chizu_traffic_interval">Re-check while driving</string>
	<string name="chizu_traffic_min_saving">Reroute when it saves</string>
	<string name="chizu_traffic_long_yellow">Long yellow from</string>
	<string name="chizu_traffic_avoid_red">Around jams</string>
	<string name="chizu_traffic_avoid_long_yellow">Around jams and long slow traffic</string>
	<string name="chizu_traffic_avoid_yellow">Around all slow traffic</string>
	<string name="chizu_traffic_shortest">Shortest distance</string>
	<string name="chizu_traffic_ignores">Fastest</string>
	<string name="chizu_traffic_checking">Checking traffic…</string>
	<string name="chizu_traffic_jam_on_route">traffic +%1$d min</string>
	<string name="chizu_traffic_no_jam">traffic 0 min</string>
	<string name="chizu_section_speeds">My driving speeds</string>
	<string name="chizu_speeds_enabled">Route with my speeds</string>
	<string name="chizu_speeds_enabled_descr">Prices every car route at the speed you drive on each road type and limit, not at the limit itself. Uses the full route search, which is slower than the fast precomputed one. Long press a row to go back to the speed you set first.</string>
	<string name="chizu_traffic_with_jam">traffic +%1$d min, 1 jam</string>
	<string name="chizu_traffic_with_jams">traffic +%1$d min, %2$d jams</string>
	<string name="chizu_traffic_times_note">times include current traffic</string>
	<string name="chizu_speeds_governed">Set in 白い熊 UI → My driving speeds while “Route with my speeds” is on. Tap to open.</string>
	<string name="chizu_speeds_slowest">Slowest counted speed</string>
	<string name="chizu_speeds_unknown">Speed on roads of unknown type</string>
	<string name="chizu_speeds_eta_follows">Arrival time follows my recent speed</string>
	<string name="chizu_speeds_eta_follows_descr">Off: the arrival time is the route’s own, with your speeds and the current traffic. On: it moves towards your average moving speed over the span below, which can’t see a jam ahead.</string>
	<string name="chizu_speeds_eta_minutes">Span of the recent speed</string>
	<string name="chizu_speeds_extra_note">Every road counts as at least the slowest speed. The fastest is always your fastest row. The Travel speed screen of the car profile is greyed out while this is on.</string>
